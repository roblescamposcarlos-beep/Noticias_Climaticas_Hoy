{
	"name": "Noticias_Climaticas_RobertoRobles",
	"flow": [
		{
			"id": 1,
			"module": "gateway:CustomWebHook",
			"version": 1,
			"parameters": { "hook": 3004041, "maxResults": 1 },
			"mapper": {},
			"metadata": {
				"designer": { "x": 0, "y": 0 },
				"interface": [
					{ "name": "tema", "type": "text", "label": "tema" }
				],
				"parameters": [
					{ "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true },
					{ "name": "maxResults", "type": "number", "label": "Maximum number of results" }
				]
			}
		},
		{
			"id": 2,
			"module": "rss:ActionReadArticles",
			"version": 4,
			"parameters": {},
			"mapper": {
				"url": "https://news.google.com/rss/search?q={{encodeURL(1.tema)}}&hl=es-419&gl=MX&ceid=MX:es-419",
				"gzip": true,
				"maxResults": "5"
			},
			"metadata": { "designer": { "x": 300, "y": 0 } }
		},
		{
			"id": 3,
			"module": "util:TextAggregator",
			"version": 1,
			"parameters": { "feeder": 2, "rowSeparator": "\n" },
			"mapper": {
				"value": "Título: {{2.title}}\nFecha: {{2.dateCreated}}\nEnlace: {{2.url}}\n"
			},
			"metadata": { "designer": { "x": 600, "y": 0 } }
		},
		{
			"id": 4,
			"module": "ai-local-agent:RunLocalAIAgent",
			"version": 0,
			"tools": [],
			"parameters": { "makeConnectionId": 10844322 },
			"mapper": {
				"files": [],
				"message": "Tema: {{1.tema}}\nNoticias:\n{{3.text}}",
				"threadId": "",
				"outputType": "text",
				"tokenLimit": "50",
				"modelConfig": { "timeout": "", "recursionLimit": "300", "aiCompactionEnabled": true, "iterationsFromHistoryCount": "10" },
				"defaultModel": "medium",
				"systemPrompt": "Eres un divulgador ambiental para alumnos de Desarrollo Sustentable del TecNM.\nRecibirás un tema y una lista de noticias recientes (título, fecha y enlace).\nUsa ÚNICAMENTE la información de esas noticias; no inventes datos ni agregues noticias que no estén en la lista.\nResponde en texto plano (sin asteriscos, sin markdown), en español, con este formato:\nRESUMEN DEL DÍA\n[3 a 4 líneas explicando de qué tratan las noticias en conjunto]\nNOTICIAS\n1. [título] - [1 línea explicando por qué importa]\n   [enlace]\n(repite para cada noticia)\n¿QUÉ PUEDO HACER YO?\n[1 acción concreta que un estudiante puede hacer relacionada con el tema]\nSi la lista de noticias viene vacía, responde: \"No se encontraron noticias recientes sobre este tema.\"",
				"promptCaching": "none",
				"fallbackEnabled": false
			},
			"metadata": { "designer": { "x": 900, "y": 0 } }
		},
		{
			"id": 5,
			"module": "gateway:WebhookRespond",
			"version": 1,
			"parameters": {},
			"mapper": {
				"body": "{{4.response}}",
				"status": "200",
				"headers": [
					{ "key": "Content-Type", "value": "text/plain; charset=utf-8" },
					{ "key": "Access-Control-Allow-Origin", "value": "*" }
				]
			},
			"metadata": { "designer": { "x": 1200, "y": 0 } }
		}
	],
	"metadata": {
		"instant": true,
		"version": 1,
		"designer": { "orphans": [] },
		"scenario": {
			"dlq": false, "slots": null, "dataloss": false, "maxErrors": 3, "autoCommit": true,
			"roundtrips": 1, "sequential": false, "confidential": false, "freshVariables": false,
			"autoCommitTriggerLast": true
		}
	}
}
